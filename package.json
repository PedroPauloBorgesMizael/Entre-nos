{
  "name": "entre-nos",
  "version": "1.0.0",
  "private": true,
  "description": "Entre Nós — site pessoal de convites de encontro",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch scripts/dev-server.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --external:postgres --external:bcryptjs --outfile=api/index.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "hash": "tsx scripts/hash.ts",
    "hash:answer": "tsx scripts/hash.ts --answer",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "test:all": "npm run typecheck && npm run smoke && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@types/node": "^26.6.5",
    "bcryptjs": "^2.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
