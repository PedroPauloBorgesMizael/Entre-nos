# ==============================================================================
# Entre Nós — Arquivo de Exemplo de Variáveis de Ambiente
# ==============================================================================
# IMPORTANTE:
#  1. NUNCA utilize o prefixo VITE_ para segredos (eles seriam expostos no frontend).
#  2. Copie este arquivo para .env.local para desenvolvimento local.
#  3. No Vercel, configure estas variáveis em Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# String de conexão do pooler do Supabase (porta 6543, modo Session/Transaction).
# Em produção, utilize o papel restrito 'entre_nos_app'.
# Exemplo: postgres://entre_nos_app:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgres://entre_nos_app:SENHA_DO_PAPEL@SEU_HOST_SUPABASE:6543/postgres?sslmode=require"

# Conexão direta com privilégios de DDL (usuário 'postgres') usada apenas para aplicar migrations:
# npm run db:migrate
MIGRATION_DATABASE_URL="postgres://postgres:SENHA_POSTGRES@SEU_HOST_SUPABASE:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. URL da Aplicação
# ------------------------------------------------------------------------------
# Utilizada para gerar links de convite e links do botão no e-mail de notificação.
# Em produção, utilize a URL https final da Vercel (sem barra no final).
# Em desenvolvimento local: http://localhost:5173
APP_URL="https://seu-projeto.vercel.app"

# ------------------------------------------------------------------------------
# 3. Autenticação Administrativa e Recuperação de Acesso
# ------------------------------------------------------------------------------
# Seu e-mail pessoal que receberá as notificações dos encontros marcados:
ADMIN_EMAIL="seu-email@exemplo.com"

# Seu nome de usuário administrativo único:
ADMIN_USERNAME="seu_usuario"

# Hash bcrypt da sua senha inicial.
# Gere localmente no terminal com: npm run hash
# Exemplo de formato: $2a$12$e8k...
ADMIN_INITIAL_PASSWORD_HASH='$2a$12$exemploDeHashBcryptSenha...'

# Perguntas de segurança para recuperação de emergência:
ADMIN_RECOVERY_QUESTION_1="Qual o nome do seu primeiro animal de estimação?"
# Hash da resposta 1 (gerado com npm run hash -- --answer):
ADMIN_RECOVERY_ANSWER_1_HASH='$2a$12$exemploDeHashBcryptResposta1...'

ADMIN_RECOVERY_QUESTION_2="Em qual cidade você nasceu?"
# Hash da resposta 2 (gerado com npm run hash -- --answer):
ADMIN_RECOVERY_ANSWER_2_HASH='$2a$12$exemploDeHashBcryptResposta2...'

# Chave secreta aleatória para assinatura dos tokens JWT da sessão (mínimo 32 caracteres):
# Dica de geração: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="cole_aqui_uma_chave_aleatoria_com_mais_de_32_caracteres"

# ------------------------------------------------------------------------------
# 4. Envio de E-mails Transacionais (Resend)
# ------------------------------------------------------------------------------
# Chave da API do Resend (obtenha em https://resend.com/api-keys).
# No plano gratuito, se você não verificou um domínio próprio, pode utilizar o remetente
# de testes onboarding@resend.dev para enviar para o seu próprio e-mail cadastrado no Resend.
RESEND_API_KEY="re_123456789_abcdefg"

# Remetente do e-mail:
# Se usar o padrão de testes do Resend:
EMAIL_FROM="Entre Nós <onboarding@resend.dev>"
# Se configurou domínio próprio no Resend (ex.: convite.seudominio.com):
# EMAIL_FROM="Entre Nós <contato@convite.seudominio.com>"

# ------------------------------------------------------------------------------
# 5. Opcional para Desenvolvimento Local
# ------------------------------------------------------------------------------
DEV_API_PORT="8787"
